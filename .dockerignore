# ---- Version control ----
.git
.gitignore

# ---- Python artifacts ----
__pycache__
*.pyc
*.pyo
*.egg-info
dist/
build/
.eggs/

# ---- Virtual environments ----
.venv
venv
env

# ---- IDE / editor ----
.vscode
.idea
*.swp
*.swo

# ---- Terraform state (contains secrets) ----
terraform/.terraform
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
terraform/.terraform.lock.hcl

# ---- Test and dev files ----
tests/
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov/
coverage.xml
.coverage

# ---- Documentation (not needed in image) ----
docs/
*.md
LICENSE

# ---- Environment files (may contain secrets) ----
.env
.env.*
*.env

# ---- Docker files (avoid recursive context) ----
Dockerfile
docker-compose*.yml
